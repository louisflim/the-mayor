# Copy this file to .streamlit/secrets.toml and paste your key between the quotes.
# secrets.toml is in .gitignore, so it never reaches GitHub.
# On Streamlit Community Cloud, paste the same lines into: your app > Settings > Secrets.

OPENAI_API_KEY = "paste-your-key-here"

# Other providers work too. Add whichever key you have:
# GEMINI_API_KEY = ""
# GROQ_API_KEY = ""
# ANTHROPIC_API_KEY = ""

# Any other OpenAI-compatible endpoint (for example one your teacher set up):
# LLM_API_KEY = ""
# LLM_BASE_URL = "https://example.com/v1"
# LLM_MODEL = "model-name"
